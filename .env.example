APP_NAME="MCP Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Bounded application log rotation by default.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mcp_gateway
DB_USERNAME=mcp_gateway
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="gateway@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Bounded operator-facing activity metadata. No request/response payloads are stored.
ACTIVITY_RETENTION_DAYS=30
ACTIVITY_MAX_ROWS=5000
ACTIVITY_PAGE_SIZE_MAX=100

MCP_BOOTSTRAP_FIXTURE_ENABLED=false
MCP_BOOTSTRAP_FIXTURE_TOKEN=
MCP_SESSION_TTL_SECONDS=3600
MCP_CLIENT_CONNECT_TIMEOUT_SECONDS=2
MCP_CLIENT_REQUEST_TIMEOUT_SECONDS=5

# ChatGPT-facing OAuth/MCP boundary.
OAUTH_PRIVATE_KEY_PATH=storage/app/private/oauth/private.key
OAUTH_PUBLIC_KEY_PATH=storage/app/private/oauth/public.key
OAUTH_CLIENT_METADATA_CACHE_SECONDS=300
OAUTH_REMOTE_CONNECT_TIMEOUT_SECONDS=2
OAUTH_REMOTE_REQUEST_TIMEOUT_SECONDS=5
OAUTH_REMOTE_MAX_RESPONSE_BYTES=65536
OAUTH_AUTH_CODE_TTL_SECONDS=600
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_CLIENT_ASSERTION_MAX_SECONDS=300
# One authenticated replay of an already-committed refresh response may be recovered briefly.
OAUTH_REFRESH_RECOVERY_SECONDS=30
OAUTH_REFRESH_RECOVERY_MAX_RECORDS=1000
MCP_MAX_BODY_BYTES=1048576

# Burst-aware ChatGPT-facing MCP ingress limits. Keep positive; tune from observed traffic.
MCP_EDGE_RATE_LIMIT_BURST_PER_SECOND=120
MCP_EDGE_RATE_LIMIT_PER_MINUTE=1200
MCP_PRINCIPAL_RATE_LIMIT_BURST_PER_SECOND=60
MCP_PRINCIPAL_RATE_LIMIT_PER_MINUTE=600

# Gateway -> WP AI Bridge OAuth client identity and bounded outbound requests.
BRIDGE_CLIENT_PRIVATE_KEY_PATH=storage/app/private/bridge-client/private.key
BRIDGE_CLIENT_PUBLIC_KEY_PATH=storage/app/private/bridge-client/public.key
BRIDGE_CLIENT_ASSERTION_TTL_SECONDS=300
BRIDGE_OAUTH_FLOW_TTL_SECONDS=600
BRIDGE_REMOTE_CONNECT_TIMEOUT_SECONDS=2
BRIDGE_REMOTE_REQUEST_TIMEOUT_SECONDS=5
BRIDGE_REMOTE_MAX_RESPONSE_BYTES=65536
