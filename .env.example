APP_NAME="MCP Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Bounded application log rotation by default.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mcp_gateway
DB_USERNAME=mcp_gateway
DB_PASSWORD=

SESSION_DRIVER=file
# Browser login idle timeout (minutes), shared by administrators and ordinary users.
SESSION_LIFETIME=120
# Optional browser-close session cookie; not a strict absolute login duration.
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
# For local HTTP, leave SECURE_COOKIE unset: config derives false.
# The web installer writes true on HTTPS production; set true manually on HTTPS.
# SESSION_SECURE_COOKIE=true
# Always keep the session inaccessible to JavaScript; SameSite is CSRF defense in depth.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
# Optional advanced settings: cookie name derives from APP_NAME.
# SESSION_COOKIE=
# Only exact proxy IPs are allowed; absent/empty trusts no forwarded headers.
# GATEWAY_TRUSTED_PROXIES=

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="gateway@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Bounded operator-facing activity metadata and credential-redacted original error evidence.
# Arbitrary request/file contents and raw credentials must not be logged.
ACTIVITY_RETENTION_DAYS=30
ACTIVITY_MAX_ROWS=5000
ACTIVITY_PAGE_SIZE_MAX=100
# Operator-visible, selectively redacted original error details (bytes).
# Truncation is explicit; raise these budgets where useful error evidence requires it.
ACTIVITY_DIAGNOSTIC_CODE_MAX_BYTES=4096
ACTIVITY_DIAGNOSTIC_MESSAGE_MAX_BYTES=65536
ACTIVITY_DIAGNOSTIC_DETAILS_MAX_BYTES=131072

MCP_BOOTSTRAP_FIXTURE_ENABLED=false
MCP_BOOTSTRAP_FIXTURE_TOKEN=
MCP_SESSION_TTL_SECONDS=3600
MCP_CLIENT_CONNECT_TIMEOUT_SECONDS=2
MCP_CLIENT_REQUEST_TIMEOUT_SECONDS=5

# ChatGPT-facing OAuth/MCP boundary.
OAUTH_PRIVATE_KEY_PATH=storage/app/private/oauth/private.key
OAUTH_PUBLIC_KEY_PATH=storage/app/private/oauth/public.key
OAUTH_CLIENT_METADATA_CACHE_SECONDS=300
OAUTH_REMOTE_CONNECT_TIMEOUT_SECONDS=2
OAUTH_REMOTE_REQUEST_TIMEOUT_SECONDS=5
OAUTH_REMOTE_MAX_RESPONSE_BYTES=65536
OAUTH_AUTH_CODE_TTL_SECONDS=600
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_CLIENT_ASSERTION_MAX_SECONDS=300
# One authenticated replay of an already-committed refresh response may be recovered briefly.
OAUTH_REFRESH_RECOVERY_SECONDS=30
OAUTH_REFRESH_RECOVERY_MAX_RECORDS=1000
MCP_MAX_BODY_BYTES=1048576

# Burst-aware ChatGPT-facing MCP ingress limits. Keep positive; tune from observed traffic.
MCP_EDGE_RATE_LIMIT_BURST_PER_SECOND=120
MCP_EDGE_RATE_LIMIT_PER_MINUTE=1200
MCP_PRINCIPAL_RATE_LIMIT_BURST_PER_SECOND=60
MCP_PRINCIPAL_RATE_LIMIT_PER_MINUTE=600

# Gateway -> WP AI Bridge OAuth client identity and bounded outbound requests.
BRIDGE_CLIENT_PRIVATE_KEY_PATH=storage/app/private/bridge-client/private.key
BRIDGE_CLIENT_PUBLIC_KEY_PATH=storage/app/private/bridge-client/public.key
BRIDGE_CLIENT_ASSERTION_TTL_SECONDS=300
BRIDGE_OAUTH_FLOW_TTL_SECONDS=600
BRIDGE_REMOTE_CONNECT_TIMEOUT_SECONDS=2
BRIDGE_REMOTE_REQUEST_TIMEOUT_SECONDS=5
BRIDGE_REMOTE_MAX_RESPONSE_BYTES=65536
# Read-only MCP tool responses only; all sizes remain bounded by the SafeHttpClient hard ceiling (8 MiB decoded body).
BRIDGE_REMOTE_READONLY_TOOL_MAX_RESPONSE_BYTES=262144
# Optional bounded WordPress execution waterfall stored in existing Activity diagnostics.
# Disabled by default. When enabled, successes below the threshold are not retained;
# downstream connector failures are retained. Pre-dispatch denials are not traced.
# Never records URL, headers, credentials, inputs or outputs.
BRIDGE_TIMING_ENABLED=false
BRIDGE_TIMING_MINIMUM_MS=1500

# New installs: authenticated SSH Direct whole-file browser/HTTPS transfer.
# Existing upgrades preserve private .env; absent key stays disabled.
# Set false to disable; per-Target authorization and host limits still apply.
SSH_FILE_TRANSFER_ENABLED=true
# SSH whole-file binary HTTPS/browser transfer only, not WordPress media or MCP chat attachments.
# Budget is per complete file, separate from 16 KiB SFTP Tool windows.
SSH_FILE_TRANSFER_MAX_BYTES=8388608
SSH_FILE_TRANSFER_MAX_SECONDS=30

# Per-Target SSH verification admission controls (not transfer throughput).
SSH_VERIFY_MAX_ATTEMPTS_PER_MINUTE=6
SSH_VERIFY_DECAY_SECONDS=60
SSH_VERIFY_LEASE_SECONDS=30

# --------------------------------------------------------------------------
# Advanced supported or dependency-gated first-party settings (OPTIONAL)
# Each example is commented: enabling it requires checking the documented
# driver, resource, credential and security implications first.
# These settings never alter the default file/sync/local baseline by themselves.
# --------------------------------------------------------------------------

# Application encryption/maintenance. Preserve existing keys during rotation.
# APP_PREVIOUS_KEYS=
# APP_MAINTENANCE_STORE=database

# Optional MySQL/MariaDB connection details. Do not change DB identity
# during an updater, browser recovery or an unresolved migration.
# DB_URL=
# DB_SOCKET=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=
# DB_FOREIGN_KEYS=true

# File/database cache. Database cache requires compatible cache tables.
# CACHE_PREFIX=
# CACHE_STORAGE_DISK=local
# CACHE_STORAGE_PATH=framework/cache/data
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=cache_locks

# Optional database/Redis queue configuration. The Gateway baseline uses
# Default queue mode is sync; do not start unapproved workers or brokers.
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90
# QUEUE_FAILED_DRIVER=database-uuids

# Optional session storage; only change with a matching session-table/backend
# migration and tested sign-in/logout/CSRF/HTTPS behavior.
# SESSION_CONNECTION=
# SESSION_STORE=
# SESSION_TABLE=sessions
# SESSION_PARTITIONED_COOKIE=false

# Optional logging destinations; protect remote endpoints and avoid raw
# sensitive payloads. Do not set arbitrary handler/formatter class names.
# LOG_DEPRECATIONS_TRACE=false
# LOG_PAPERTRAIL_HANDLER=
# LOG_SLACK_EMOJI=:boom:
# LOG_SLACK_USERNAME=
# LOG_SLACK_WEBHOOK_URL=
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=8
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=

# Optional SMTP/sendmail settings. Default MAIL_MAILER=log does not send
# external mail. Never put live credentials in a committed template.
# MAIL_EHLO_DOMAIN=
# MAIL_HOST=127.0.0.1
# MAIL_LOG_CHANNEL=
# MAIL_PASSWORD=
# MAIL_PORT=2525
# MAIL_SCHEME=
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# MAIL_URL=
# MAIL_USERNAME=

# Dependency-gated Memcached cache settings; not enabled by the baseline.
# Requires a verified installed PHP Memcached extension/server and operator
# change to CACHE_STORE, otherwise the file cache stays active.
# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# MEMCACHED_PERSISTENT_ID=
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=

# Dependency-gated Redis settings; not enabled by the baseline. Require a
# compatible extension/server, private network binding and admission review
# before selecting a Redis-backed CACHE_STORE, SESSION_DRIVER or queue driver.
# REDIS_CLIENT=phpredis
# REDIS_URL=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_PREFIX=
# REDIS_PERSISTENT=false
# REDIS_CLUSTER=redis
# REDIS_MAX_RETRIES=3
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
# REDIS_BACKOFF_BASE=100
# REDIS_BACKOFF_CAP=1000
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90

# DANGEROUS: one-time legacy Site-to-Target data reset/transition ONLY.
# NEVER enable casually to repair a normal Gateway or during a routine update.
# Follow docs/TARGET-TRANSITION-RUNBOOK.md and verify a restorable DB backup
# before supplying the explicitly required values via operator procedure.
# GATEWAY_TARGET_RESET_ACKNOWLEDGED=
# GATEWAY_TARGET_RESET_DATABASE_BACKUP_VERIFIED=

# Disposable recovery fixture ONLY. Never set on a real installation.
# APP_ENV must be testing, origin localhost loopback HTTP with safe port.
# MCP_GATEWAY_RECOVERY_TEST_LOOPBACK=
