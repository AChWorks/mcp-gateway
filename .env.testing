APP_NAME="MCP Gateway Test"
APP_ENV=testing
APP_KEY=base64:a2tra2tra2tra2tra2tra2tra2tra2tra2tra2tra2s=
APP_DEBUG=false
APP_URL=http://127.0.0.1

LOG_CHANNEL=null
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
SESSION_DRIVER=array
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

MCP_BOOTSTRAP_FIXTURE_ENABLED=false
MCP_BOOTSTRAP_FIXTURE_TOKEN=
MCP_SESSION_TTL_SECONDS=3600
MCP_CLIENT_CONNECT_TIMEOUT_SECONDS=2
MCP_CLIENT_REQUEST_TIMEOUT_SECONDS=5

OAUTH_PRIVATE_KEY_PATH=storage/framework/testing/oauth/private.key
OAUTH_PUBLIC_KEY_PATH=storage/framework/testing/oauth/public.key
OAUTH_CLIENT_METADATA_CACHE_SECONDS=300
OAUTH_REMOTE_CONNECT_TIMEOUT_SECONDS=1
OAUTH_REMOTE_REQUEST_TIMEOUT_SECONDS=2
OAUTH_REMOTE_MAX_RESPONSE_BYTES=65536
OAUTH_AUTH_CODE_TTL_SECONDS=600
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_CLIENT_ASSERTION_MAX_SECONDS=300
MCP_MAX_BODY_BYTES=1048576

BRIDGE_CLIENT_PRIVATE_KEY_PATH=storage/framework/testing/bridge-client/private.key
BRIDGE_CLIENT_PUBLIC_KEY_PATH=storage/framework/testing/bridge-client/public.key
BRIDGE_CLIENT_ASSERTION_TTL_SECONDS=120
BRIDGE_OAUTH_FLOW_TTL_SECONDS=600
BRIDGE_REMOTE_CONNECT_TIMEOUT_SECONDS=1
BRIDGE_REMOTE_REQUEST_TIMEOUT_SECONDS=2
BRIDGE_REMOTE_MAX_RESPONSE_BYTES=65536
